{
  "name": "magnitude-extract",
  "version": "0.0.2",
  "description": "TypeScript DOM cleaning and structuring library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "unstructured-ts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "lint": "eslint src",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "dom",
    "html",
    "cleaning",
    "parsing",
    "structured-data"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "@eslint/js": "^10.0.1",
    "globals": "^16.5.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1"
  }
}
