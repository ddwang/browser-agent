{
  "name": "magnitude-test",
  "version": "0.3.13",
  "description": "A TypeScript client for running automated UI tests through the Magnitude testing platform",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "magnitude": "dist/cli.mjs"
  },
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnitudedev/magnitude.git"
  },
  "homepage": "https://github.com/magnitudedev/magnitude#readme",
  "bugs": {
    "url": "https://github.com/magnitudedev/magnitude/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "check": "tsc --noEmit",
    "cli": "bun src/cli.ts",
    "cli-bin": "bun dist/cli.mjs",
    "pubdev": "bun run build && yalc publish --force --push",
    "prepack": "node ../../scripts/prepare-browser-package.mjs"
  },
  "keywords": [
    "testing",
    "ui-testing",
    "automation",
    "magnitude",
    "typescript"
  ],
  "author": {
    "name": "Magnitude",
    "email": "founders@magnitude.run",
    "url": "https://magnitude.run"
  },
  "contributors": [
    "Anders Lie <anders@magnitude.run>",
    "Tom Greenwald <tom@magnitude.run>"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "typescript": "~5.7.2",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "dotenv": "^16.5.0",
    "esbuild": "^0.28.2",
    "glob": "^14.0.2",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "jiti": "^2.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "npm:patchright@1.64.3",
    "posthog-node": "^5.61.1",
    "react": "^19.3.0",
    "std-env": "^3.9.0",
    "zod": "^4.6.6",
    "@ddwang/magnitude-core": "^0.3.1-ddwang.18",
    "eventemitter3": "^5.0.1",
    "patchright-core": "1.64.3"
  },
  "bundledDependencies": [
    "playwright",
    "patchright-core"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
